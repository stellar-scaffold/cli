{
  "name": "stellar-scaffold-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations --locale es",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "formatter": "prettier --write \"{blog,docs,src/pages}/**/*.{md,mdx}\"",
    "linter": "prettier -c \"{blog,docs,src/pages}/**/*.{md,mdx}\" && npm run lint:admonitions",
    "lint:admonitions": "! grep -rnE '^[[:space:]]*:::[[:alnum:]].*:::[[:space:]]*$' blog docs src/pages i18n || (echo 'Admonitions need :::type and the closing ::: on lines of their own, separated from the body by blank lines.' && false)"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/plugin-client-redirects": "3.9.2",
    "@docusaurus/plugin-ideal-image": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "@stellar/prettier-config": "^1.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "serialize-javascript": "^7.1.2",
    "sharp": "^0.35.5",
    "webpack": "5.103.0"
  }
}
